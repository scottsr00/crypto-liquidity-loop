[Unit]
Description=Crypto Liquidity Loop private dashboard
After=network.target

[Service]
Type=simple
User=liquidity-loop
WorkingDirectory=/opt/liquidity-loop
EnvironmentFile=-/etc/liquidity-loop/secrets.env
ExecStart=/opt/liquidity-loop/.venv/bin/liquidity-loop --config /etc/liquidity-loop/config.toml dashboard
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liquidity-loop

[Install]
WantedBy=multi-user.target
